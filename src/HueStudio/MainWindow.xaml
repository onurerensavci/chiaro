                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                              <GradientStop Color="#FF3B30" Offset="0" />
                              <GradientStop Color="#FF9F0A" Offset="0.6" />
                              <GradientStop Color="#FFD60A" Offset="1" />
                            </LinearGradientBrush>
                          </Path.Stroke>
                        </Path>
                        <TextBlock x:Name="TabFireText" Text="Şömine" FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="NoWrap" />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabDaylight" Style="{StaticResource ModeTile}" Tag="Gün ışığı" Click="ModeTile_Click" ToolTip="Gün boyu beyaz ton">
