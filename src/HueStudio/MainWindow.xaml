                        <Path Data="M2,18 H22 M6,18 A6,6 0 0 1 18,18 M12,6 V8 M4.5,10.5 L6,12 M19.5,10.5 L18,12" Stroke="#FFD27A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" HorizontalAlignment="Center" />
