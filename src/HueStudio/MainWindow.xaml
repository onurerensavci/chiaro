<Window x:Class="HueStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hue Studio" Icon="Assets/HueStudio.ico"
        Width="1220" Height="940" MinWidth="960" MinHeight="660"
        Background="{DynamicResource Backdrop}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">
  <Grid x:Name="RootGrid">
    <!-- Sistem bulanıklığı varken yarı saydam renk katmanı -->
    <Border Background="{DynamicResource BackdropTint}" IsHitTestVisible="False" />

    <!-- Arka planda süzülen ışık lekeleri: biri ampulün canlı rengini izler -->
    <Canvas x:Name="Blobs" IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse x:Name="BlobLive" Width="720" Height="720" Canvas.Left="-220" Canvas.Top="-260" Opacity="0.55" />
      <Ellipse x:Name="BlobA" Width="640" Height="640" Canvas.Left="720" Canvas.Top="260" Opacity="0.40" />
      <Ellipse x:Name="BlobB" Width="520" Height="520" Canvas.Left="300" Canvas.Top="560" Opacity="0.30" />
    </Canvas>

    <DockPanel Margin="26,18,26,18">
      <!-- ÜST BAŞLIK -->
      <DockPanel DockPanel.Dock="Top" Margin="4,0,4,14">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource Pill}" Margin="0,0,10,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="#FF9F0A" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock x:Name="ConnText" Text="Bağlı değil" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Button Content="Mini" Click="Mini_Click" ToolTip="Her zaman üstte mini çubuk" />
          <Button Content="Küçült" Margin="0" Click="Hide_Click" ToolTip="Saat yanına gizle" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="{StaticResource LogoImage}" Width="38" Height="38" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect>
              <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#2A1240" />
            </Image.Effect>
          </Image>
          <TextBlock Text="Hue Studio" FontSize="24" FontWeight="SemiBold" Margin="12,0,0,1" VerticalAlignment="Center" TextWrapping="NoWrap" />
        </StackPanel>
      </DockPanel>

      <!-- DURUM ŞERİDİ -->
      <ContentControl DockPanel.Dock="Top" Style="{StaticResource GlassCard}" Padding="18,12" Margin="0,0,0,14">
        <DockPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
            <Button x:Name="CancelButton" Content="İptal" Visibility="Collapsed" Click="Cancel_Click" />
            <Button x:Name="RefreshButton" Content="Yenile" IsEnabled="False" Click="Refresh_Click" />
            <Button x:Name="DisconnectButton" Content="Bağlantıyı kes" IsEnabled="False" Margin="0" Click="Disconnect_Click" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="Ampulünü bağla." FontWeight="SemiBold" />
            <TextBlock x:Name="DetailText" Text="Son ampul otomatik hatırlanır." FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" />
          </StackPanel>
        </DockPanel>
      </ContentControl>

      <!-- ALT MENÜ (dock) -->
      <ContentControl DockPanel.Dock="Bottom" Style="{StaticResource GlassCard}" Padding="14,10" Margin="0,14,0,0">
        <DockPanel LastChildFill="True">
          <!-- sol: mini güç + şu anki renk -->
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="DockPower" Width="44" Height="44" Padding="0" Margin="0,0,12,0" Click="PowerToggleQuick_Click" ToolTip="Aç / Kapat">
              <Grid Width="22" Height="26">
                <Path x:Name="DockBulb" Stretch="Uniform" Fill="#6B7385"
                      Data="M50,5 C27,5 10,22 10,44 C10,58 17,68 26,76 C31,81 33,86 33,92 L67,92 C67,86 69,81 74,76 C83,68 90,58 90,44 C90,22 73,5 50,5 Z M35,98 L65,98 L65,104 L35,104 Z M38,108 L62,108 C60,114 55,117 50,117 C45,117 40,114 38,108 Z" />
              </Grid>
            </Button>
            <Grid Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
              <Ellipse x:Name="DockChipGlow" Margin="-6" Opacity="0" />
              <Ellipse x:Name="DockChip" Stroke="#59FFFFFF" StrokeThickness="1" />
            </Grid>
            <StackPanel VerticalAlignment="Center" MinWidth="150">
              <TextBlock x:Name="DockColorName" Text="Renk yok" FontWeight="SemiBold" FontSize="13" TextWrapping="NoWrap" />
              <TextBlock x:Name="DockDetail" Text="Manuel" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" />
            </StackPanel>
            <Border Width="1" Background="{DynamicResource Stroke}" Margin="14,4" />
          </StackPanel>
          <!-- sağ: tema, cam, sürüm -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="1" Background="{DynamicResource Stroke}" Margin="6,4,14,4" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBlock Text="Parlaklık" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" />
              <TextBlock x:Name="DockBrightness" Text="%70" FontWeight="SemiBold" FontSize="13" TextWrapping="NoWrap" />
            </StackPanel>
            <Button x:Name="GlassButton" Style="{StaticResource Small}" Content="Cam: Açık" Click="Glass_Click" />
            <Button x:Name="ThemeButton" Style="{StaticResource Small}" Content="Açık tema" Click="Theme_Click" />
            <Button Style="{StaticResource HeaderButton}" Click="About_Click" ToolTip="Hakkında" Margin="4,0,0,0" VerticalAlignment="Center">
              <StackPanel>
                <TextBlock Text="Hue Studio 3.2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" HorizontalAlignment="Right" />
                <TextBlock Text="Onur Eren Savcı × Grok Bot" FontSize="10" Foreground="{DynamicResource Muted}" Opacity="0.75" TextWrapping="NoWrap" HorizontalAlignment="Right" />
              </StackPanel>
            </Button>
          </StackPanel>
          <!-- orta: hızlı renkler -->
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="FAVORİLER" Style="{StaticResource SectionLabel}" FontSize="10" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel x:Name="QuickSwatches" Orientation="Horizontal" />
            </ScrollViewer>
          </StackPanel>
        </DockPanel>
      </ContentControl>

      <!-- İÇERİK -->
      <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.35*" />
          </Grid.ColumnDefinitions>

          <!-- SOL SÜTUN -->
          <StackPanel Grid.Column="0">
            <!-- Cihaz -->
            <ContentControl Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="DeviceChev" Style="{StaticResource Chevron}" DockPanel.Dock="Right" Tag="device" Click="Section_Click" />
                  <TextBlock x:Name="ScanSummary" DockPanel.Dock="Right" Text="Açık ve yakında olsun." FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextAlignment="Right" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                  <Button Style="{StaticResource HeaderButton}" Tag="device" Click="Section_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><TextBlock Text="Cihaz" FontSize="22" FontWeight="SemiBold" TextWrapping="NoWrap" /></Button>
                </DockPanel>
                <StackPanel x:Name="DeviceBody" Margin="0,10,0,0">
                <ComboBox x:Name="Devices" AutomationProperties.Name="Ampul seç" SelectionChanged="Selection_Changed" Margin="0,0,0,10">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                        <TextBlock x:Name="Tail" Text="{Binding Tail}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue={x:Null}, TargetNullValue={x:Null}}" Value="{x:Null}">
                          <Setter TargetName="Tail" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <UniformGrid Columns="2">
                  <Button x:Name="ScanButton" Content="Tara" Click="Scan_Click" />
                  <Button x:Name="ConnectButton" Content="Bağlan" Style="{StaticResource Primary}" IsEnabled="False" Margin="0" Click="Connect_Click" />
                </UniformGrid>
                </StackPanel>
              </StackPanel>
            </ContentControl>

            <!-- Ampul (açılır/kapanır) -->
            <ContentControl Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="BulbChev" Style="{StaticResource Chevron}" DockPanel.Dock="Right" Tag="bulb" Click="Section_Click" />
                  <ToggleButton x:Name="PowerToggle" Style="{StaticResource Switch}" DockPanel.Dock="Right" IsEnabled="False" VerticalAlignment="Center" Margin="10,0,0,0" Click="PowerToggle_Click" AutomationProperties.Name="Işık aç/kapat" ToolTip="Aç / Kapat" />
                  <Button Style="{StaticResource HeaderButton}" Tag="bulb" Click="Section_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel>
                      <TextBlock Text="AMPUL" Style="{StaticResource SectionLabel}" />
                      <TextBlock x:Name="LightTitle" Text="Hue" FontSize="22" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                </DockPanel>

                <StackPanel x:Name="BulbBody" Margin="0,8,0,0">
                  <!-- Parlayan ampul -->
                  <Grid Height="190" Margin="0,4,0,4">
                    <Ellipse x:Name="BulbHalo" Width="210" Height="210" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                      <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="BulbHaloScale" ScaleX="0.8" ScaleY="0.8" />
                      </Ellipse.RenderTransform>
                    </Ellipse>
                    <Button Style="{StaticResource HeaderButton}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="PowerToggleQuick_Click" ToolTip="Aç / Kapat">
                      <Viewbox Width="96" Height="118">
                        <Canvas Width="100" Height="120">
                          <Path x:Name="BulbGlass" Stroke="#73FFFFFF" StrokeThickness="1.5"
                                Data="M50,5 C27,5 10,22 10,44 C10,58 17,68 26,76 C31,81 33,86 33,92 L67,92 C67,86 69,81 74,76 C83,68 90,58 90,44 C90,22 73,5 50,5 Z">
                            <Path.Effect>
                              <DropShadowEffect x:Name="BulbShadow" ShadowDepth="0" BlurRadius="0" Opacity="0" Color="White" />
                            </Path.Effect>
                          </Path>
                          <Path Data="M28,26 C33,16 42,12 50,12" Stroke="#8CFFFFFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                          <Path x:Name="BulbFilament" Data="M40,90 L40,62 L45,54 L50,62 L55,54 L60,62 L60,90" Stroke="#8090A0" StrokeThickness="2.4" StrokeLineJoin="Round" />
                          <Path Data="M35,96 L65,96 L65,103 L35,103 Z M36,106 L64,106 L64,112 L36,112 Z M42,114 L58,114 C56,118 44,118 42,114 Z">
                            <Path.Fill>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#8C95A6" Offset="0" />
                                <GradientStop Color="#E6EAF0" Offset="0.45" />
                                <GradientStop Color="#7A8394" Offset="1" />
                              </LinearGradientBrush>
                            </Path.Fill>
                          </Path>
                        </Canvas>
                      </Viewbox>
                    </Button>
                  </Grid>
                  <TextBlock x:Name="StateText" Text="Bağlı değil." Foreground="{DynamicResource Muted}" FontSize="12" TextAlignment="Center" Margin="0,0,0,12" MinHeight="32" />

                  <!-- Parlaklık -->
                  <Border Style="{StaticResource Pill}" CornerRadius="16" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock x:Name="BrightnessLabel" Text="%70" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentSoft}" DockPanel.Dock="Right" />
                        <TextBlock Text="Parlaklık" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </DockPanel>
                      <Grid x:Name="BrightnessPanel" IsEnabled="False" Margin="0,6,0,0">
                        <Slider x:Name="BrightnessSlider" Minimum="1" Maximum="100" Value="70" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Parlaklık" ValueChanged="Brightness_Changed" PreviewMouseLeftButtonUp="BrightnessSlider_Release" KeyUp="BrightnessSlider_KeyUp" />
                      </Grid>
                      <TextBlock x:Name="BrightnessHint" Text="" Visibility="Collapsed" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>

                  <!-- Beyaz tonu -->
                  <Border Style="{StaticResource Pill}" CornerRadius="16" Padding="14,10">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock x:Name="TemperatureLabel" Text="2700 K" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentSoft}" DockPanel.Dock="Right" />
                        <TextBlock Text="Beyaz tonu" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </DockPanel>
                      <Grid x:Name="TemperaturePanel" IsEnabled="False" Margin="0,6,0,0">
                        <Slider x:Name="TemperatureSlider" Minimum="2200" Maximum="6500" Value="2700" IsSnapToTickEnabled="True" TickFrequency="100" AutomationProperties.Name="Beyaz sıcaklığı" ValueChanged="Temperature_Changed" PreviewMouseLeftButtonUp="TemperatureSlider_Release" KeyUp="TemperatureSlider_KeyUp">
                          <Slider.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                              <GradientStop Color="#FFB46B" Offset="0" />
                              <GradientStop Color="#FFE7C7" Offset="0.5" />
                              <GradientStop Color="#DCE9FF" Offset="1" />
                            </LinearGradientBrush>
                          </Slider.Foreground>
                        </Slider>
                      </Grid>
                      <DockPanel Margin="0,2,0,0">
                        <TextBlock Text="Sıcak" FontSize="10" Foreground="{DynamicResource Muted}" />
                        <TextBlock Text="Serin" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" />
                      </DockPanel>
                      <TextBlock x:Name="TemperatureHint" Text="" Visibility="Collapsed" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </ContentControl>

            <!-- Renkler -->
            <ContentControl Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="ColorsChev" Style="{StaticResource Chevron}" DockPanel.Dock="Right" Tag="colors" Click="Section_Click" />
                  <Button Style="{StaticResource HeaderButton}" Tag="colors" Click="Section_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><TextBlock Text="Renkler" FontSize="22" FontWeight="SemiBold" TextWrapping="NoWrap" /></Button>
                </DockPanel>

                <StackPanel x:Name="ColorsBody" Margin="0,10,0,0">
                  <StackPanel x:Name="ColorPanel" />

                  <!-- Özel renk -->
                  <Border Style="{StaticResource Pill}" CornerRadius="18" Padding="14" Margin="0,6,0,0">
                    <DockPanel>
                      <Grid DockPanel.Dock="Left" Width="176" Height="176" Margin="0,0,18,0">
                        <Image x:Name="Wheel" Width="176" Height="176" Cursor="Cross" MouseLeftButtonDown="Wheel_MouseDown" MouseMove="Wheel_MouseMove" MouseLeftButtonUp="Wheel_MouseUp" />
                        <Canvas IsHitTestVisible="False">
                          <Ellipse x:Name="WheelMarker" Width="18" Height="18" Stroke="White" StrokeThickness="3">
                            <Ellipse.Effect>
                              <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.7" />
                            </Ellipse.Effect>
                          </Ellipse>
                        </Canvas>
                      </Grid>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ÖZEL" Style="{StaticResource SectionLabel}" />
                        <DockPanel Margin="0,8,0,0">
                          <Border x:Name="CustomPreview" Width="46" Height="46" CornerRadius="23" DockPanel.Dock="Left" BorderBrush="#59FFFFFF" BorderThickness="1" Margin="0,0,12,0" />
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Hex" FontSize="11" Foreground="{DynamicResource Muted}" />
                            <TextBox x:Name="HexBox" Text="#FF8C1A" Margin="0,3,0,0" MaxLength="7" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" />
                          </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                          <TextBlock Text="Doygunluk" Style="{StaticResource OptionLabel}" Width="78" />
                          <TextBlock x:Name="SatLabel" Style="{StaticResource OptionValue}" DockPanel.Dock="Right" Width="44" TextAlignment="Right" />
                          <Slider x:Name="SatSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="SatSlider_Changed" PreviewMouseLeftButtonUp="SatSlider_Release" KeyUp="SatSlider_KeyUp" />
                        </DockPanel>
                        <WrapPanel Margin="0,10,0,0">
                          <Button Content="☆ Favori" ToolTip="Favorilere ekle" Click="AddFavorite_Click" Margin="0" />
                        </WrapPanel>
                        <TextBlock x:Name="ColorHint" Text="" Visibility="Collapsed" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <TextBlock Text="SON RENKLER" Style="{StaticResource SectionLabel}" Margin="0,14,0,8" />
                  <WrapPanel x:Name="RecentPanel" />
                  <TextBlock x:Name="RecentEmpty" Text="Henüz yok." FontSize="11" Foreground="{DynamicResource Muted}" />
                </StackPanel>
              </StackPanel>
            </ContentControl>

            <!-- Genel -->
            <ContentControl Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="GeneralChev" Style="{StaticResource Chevron}" DockPanel.Dock="Right" Tag="general" Click="Section_Click" />
                  <Button Style="{StaticResource HeaderButton}" Tag="general" Click="Section_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><TextBlock Text="Genel" FontSize="22" FontWeight="SemiBold" TextWrapping="NoWrap" /></Button>
                </DockPanel>
                <StackPanel x:Name="GeneralBody" Margin="0,6,0,0">
                <CheckBox x:Name="AutoStartBox" Content="Windows ile başlat" ToolTip="Açılışta saat yanında gizli başlar" Click="AutoStart_Click" />
                <CheckBox x:Name="AnimBox" Content="Animasyonlar" Click="Anim_Click" />
                <CheckBox x:Name="WheelBox" Content="Simgede tekerlekle parlaklık" ToolTip="Saat yanındaki simgenin üzerinde fare tekerleği" Click="WheelBox_Click" />
                <TextBlock x:Name="WheelHint" Text="" Visibility="Collapsed" FontSize="11" Foreground="{DynamicResource Muted}" Margin="30,0,0,0" />
                </StackPanel>
              </StackPanel>
            </ContentControl>

            <WrapPanel Margin="0,0,0,14">
              <Button Content="Yardım" Style="{StaticResource Small}" Margin="0,0,8,8" Click="Help_Click" />
              <Button Content="Bluetooth" Style="{StaticResource Small}" Margin="0,0,8,8" Click="Settings_Click" />
              <Button x:Name="ForgetButton" Content="Unut" Style="{StaticResource Small}" Margin="0,0,8,8" Click="Forget_Click" />
              <Button Content="Tanı raporu" ToolTip="Hata ayıklama kaydını kaydet" Style="{StaticResource Small}" Margin="0,0,8,8" Click="Report_Click" />
            </WrapPanel>
          </StackPanel>

          <!-- SAĞ SÜTUN -->
          <StackPanel Grid.Column="2">
            <!-- Sahneler -->
            <ContentControl x:Name="SceneCard" Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="ScenesChev" Style="{StaticResource Chevron}" DockPanel.Dock="Right" Tag="scenes" Click="Section_Click" />
                  <StackPanel x:Name="ScenesActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Kaydet" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0" Click="SceneSave_Click" ToolTip="Şu anki ışığı sahne olarak kaydet" />
                    <Button x:Name="SceneMoreButton" Content="•••" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="6,0,0,0" Padding="10,4" Click="SceneMore_Click" ToolTip="Diğer" />
                  </StackPanel>
                  <Button Style="{StaticResource HeaderButton}" Tag="scenes" Click="Section_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel>
                      <TextBlock Text="Sahneler" FontSize="22" FontWeight="SemiBold" TextWrapping="NoWrap" />
                      <TextBlock Text="Tek dokunuş. Düzenlemek için sağ tıkla." FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel></Button>
                </DockPanel>
                <StackPanel x:Name="ScenesBody" Margin="0,12,0,0">
                  <WrapPanel x:Name="SceneTiles" Margin="0,0,-10,0" />
                </StackPanel>
              </StackPanel>
            </ContentControl>

            <!-- Modlar -->
            <ContentControl x:Name="ModesCard" Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="ModesChev" Style="{StaticResource Chevron}" DockPanel.Dock="Right" Tag="modes" Click="Section_Click" />
                  <Border x:Name="ModesActions" Style="{StaticResource Pill}" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="10,4">
                    <TextBlock x:Name="ModeBadge" Text="MANUEL" Foreground="{DynamicResource ModeText}" FontSize="10" FontWeight="SemiBold" TextWrapping="NoWrap" />
                  </Border>
                  <Button Style="{StaticResource HeaderButton}" Tag="modes" Click="Section_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><TextBlock Text="Modlar" FontSize="22" FontWeight="SemiBold" TextWrapping="NoWrap" /></Button>
                </DockPanel>
                <StackPanel x:Name="ModesBody" Margin="0,10,0,0">
                  <UniformGrid Columns="4" Margin="0,4,-8,0">
                    <RadioButton x:Name="TabManual" Style="{StaticResource ModeTile}" Tag="Manuel" Click="ModeTile_Click">
                      <StackPanel>
                        <Path Data="M3,7 H21 M3,17 H21 M8,4 V10 M16,14 V20" Stroke="{DynamicResource Text}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TabManualText" Text="Manuel" FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="NoWrap" />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabScreen" Style="{StaticResource ModeTile}" Tag="Ekran" Click="ModeTile_Click">
                      <StackPanel>
                        <Path Data="M3,4 H21 V16 H3 Z M9,20 H15 M12,16 V20" Stroke="#64D2FF" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TabScreenText" Text="Ekran" FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="NoWrap" />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabAudio" Style="{StaticResource ModeTile}" Tag="Ses" Click="ModeTile_Click">
                      <StackPanel>
                        <Path Data="M4,10 V14 M8,7 V17 M12,4 V20 M16,8 V16 M20,11 V13" Stroke="#30D158" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TabAudioText" Text="Ses" FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="NoWrap" />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabSpotify" Style="{StaticResource ModeTile}" Tag="Spotify" Click="ModeTile_Click" ToolTip="Albüm kapağının rengi">
                      <StackPanel>
