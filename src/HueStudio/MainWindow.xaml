                  </UniformGrid>

                  <!-- Mod seçenekleri -->
                  <Border x:Name="ModeOptionsHost" Style="{StaticResource Pill}" CornerRadius="18" Padding="16,14" Margin="0,12,0,0">
                    <StackPanel>
                      <!-- Manuel -->
                      <StackPanel x:Name="OptManual">
                        <TextBlock Text="Manuel" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Modlar durur, ampul son ayarında kalır." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" />
                      </StackPanel>

                      <!-- Ekran -->
                      <StackPanel x:Name="OptScreen" Visibility="Collapsed">
                        <DockPanel>
                          <Button Content="Varsayılana dön" Style="{StaticResource Small}" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,3" FontSize="11.5" Tag="Ekran" Click="ModeDefaults_Click" ToolTip="Bu modun ayarlarını sıfırla" />
                          <TextBlock Text="Ekran" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Ekranın rengi ampule yansır." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,8" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="118" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Grid.Row="0" Text="Güncelleme" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="0" Grid.Column="1" x:Name="ScreenInterval" Minimum="50" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Screen.IntervalMs, Mode=TwoWay}" />
                          <TextBlock Grid.Row="0" Grid.Column="2" x:Name="ScreenIntervalText" Style="{StaticResource OptionValue}" />

                          <TextBlock Grid.Row="1" Text="Alan" Style="{StaticResource OptionLabel}" />
                          <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ScreenArea" Margin="0,4" SelectedIndex="{Binding Screen.Area, Mode=TwoWay}" />

                          <TextBlock Grid.Row="2" Text="Monitör" Style="{StaticResource OptionLabel}" />
                          <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ScreenMonitor" Margin="0,4" DropDownOpened="ScreenMonitor_DropDownOpened" />

                          <TextBlock Grid.Row="3" Text="Yumuşatma" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="95" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Screen.Smoothing, Mode=TwoWay}" x:Name="ScreenSmoothing" />
                          <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=ScreenSmoothing, StringFormat={}%{0:F0}}" />

                          <TextBlock Grid.Row="4" Text="Yöntem" Style="{StaticResource OptionLabel}" />
                          <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ScreenMethod" Margin="0,4" SelectedIndex="{Binding Screen.Method, Mode=TwoWay}" />

                          <TextBlock Grid.Row="5" Text="Canlılık" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Screen.SaturationBoost, Mode=TwoWay}" x:Name="ScreenBoost" />
                          <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=ScreenBoost, StringFormat={}%{0:F0}}" />
                        </Grid>
                        <CheckBox Content="Koyu alanları yok say" IsChecked="{Binding Screen.IgnoreDark, Mode=TwoWay}" Margin="0,8,0,2" />
                        <CheckBox Content="Parlaklık ekrana uysun" IsChecked="{Binding Screen.FollowBrightness, Mode=TwoWay}" />
                      </StackPanel>

                      <!-- Ses -->
                      <StackPanel x:Name="OptAudio" Visibility="Collapsed">
                        <DockPanel>
                          <Button Content="Varsayılana dön" Style="{StaticResource Small}" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,3" FontSize="11.5" Tag="Ses" Click="ModeDefaults_Click" ToolTip="Bu modun ayarlarını sıfırla" />
                          <TextBlock Text="Ses" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Işık müzikle nabız gibi atar. Kayıt yapılmaz." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,8" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Grid.Row="0" Text="Hassasiyet" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="0" Grid.Column="1" x:Name="Sensitivity" Minimum="1" Maximum="12" Value="{Binding Audio.Sensitivity, Mode=TwoWay}" AutomationProperties.Name="Ses hassasiyeti" />
                          <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=Sensitivity, StringFormat={}{0:F1}×}" />

                          <TextBlock Grid.Row="1" Text="Tepki" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="1" Grid.Column="1" x:Name="AudioAttack" Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Audio.Attack, Mode=TwoWay}" />
                          <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=AudioAttack, StringFormat={}%{0:F0}}" />

                          <TextBlock Grid.Row="2" Text="Sönme" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="2" Grid.Column="1" x:Name="AudioRelease" Minimum="5" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Audio.Release, Mode=TwoWay}" />
                          <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=AudioRelease, StringFormat={}%{0:F0}}" />

                          <TextBlock Grid.Row="3" Text="En düşük" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="3" Grid.Column="1" x:Name="AudioMin" Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Audio.MinBrightness, Mode=TwoWay}" />
                          <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=AudioMin, StringFormat={}%{0:F0}}" />

                          <TextBlock Grid.Row="4" Text="En yüksek" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="4" Grid.Column="1" x:Name="AudioMax" Minimum="20" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Audio.MaxBrightness, Mode=TwoWay}" />
                          <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=AudioMax, StringFormat={}%{0:F0}}" />

                          <TextBlock Grid.Row="5" Text="Güncelleme" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="5" Grid.Column="1" x:Name="AudioInterval" Minimum="100" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Audio.IntervalMs, Mode=TwoWay}" />
                          <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=AudioInterval, StringFormat={}{0:F0} ms}" />
                        </Grid>
                      </StackPanel>

                      <!-- Gökkuşağı -->
                      <StackPanel x:Name="OptRainbow" Visibility="Collapsed">
                        <DockPanel>
                          <Button Content="Varsayılana dön" Style="{StaticResource Small}" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,3" FontSize="11.5" Tag="Gökkuşağı" Click="ModeDefaults_Click" ToolTip="Bu modun ayarlarını sıfırla" />
                          <TextBlock Text="Gökkuşağı" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Renkler seçtiğin yönde akar." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,8" />
                        <DockPanel>
                          <Grid DockPanel.Dock="Left" Width="22" Margin="0,4,16,4">
                            <Border x:Name="RainbowBar" CornerRadius="11" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" />
                            <Canvas x:Name="RainbowMarkerCanvas">
                              <Ellipse x:Name="RainbowMarker" Width="18" Height="18" Canvas.Left="2" Stroke="White" StrokeThickness="2.5">
                                <Ellipse.Effect>
                                  <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.6" />
                                </Ellipse.Effect>
                              </Ellipse>
                            </Canvas>
                          </Grid>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="130" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Yön" Style="{StaticResource OptionLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="RainbowDirectionBox" Margin="0,4" SelectedIndex="{Binding Rainbow.Direction, Mode=TwoWay}" />

                            <TextBlock Grid.Row="1" Text="Palet" Style="{StaticResource OptionLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="RainbowPaletteBox" Margin="0,4" SelectedIndex="{Binding Rainbow.Palette, Mode=TwoWay}" SelectionChanged="RainbowPalette_Changed" />

                            <TextBlock Grid.Row="2" Text="Tur süresi" Style="{StaticResource OptionLabel}" />
                            <Slider Grid.Row="2" Grid.Column="1" x:Name="RainbowCycle" Minimum="4" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" IsDirectionReversed="True" Value="{Binding Rainbow.CycleSeconds, Mode=TwoWay}" ToolTip="Sağa: daha hızlı" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=RainbowCycle, StringFormat={}{0:F0} sn}" />

                            <TextBlock Grid.Row="3" Text="Doygunluk" Style="{StaticResource OptionLabel}" />
                            <Slider Grid.Row="3" Grid.Column="1" x:Name="RainbowSat" Minimum="30" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Rainbow.Saturation, Mode=TwoWay}" ValueChanged="RainbowPalette_Changed" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=RainbowSat, StringFormat={}%{0:F0}}" />

                            <TextBlock Grid.Row="4" Text="Güncelleme" Style="{StaticResource OptionLabel}" />
                            <Slider Grid.Row="4" Grid.Column="1" x:Name="RainbowInterval" Minimum="100" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Rainbow.IntervalMs, Mode=TwoWay}" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=RainbowInterval, StringFormat={}{0:F0} ms}" />

                            <CheckBox Grid.Row="5" Grid.ColumnSpan="3" x:Name="RainbowUseBri" Content="Sabit parlaklık" IsChecked="{Binding Rainbow.UseBrightness, Mode=TwoWay}" />
                            <TextBlock Grid.Row="6" Text="Parlaklık" Style="{StaticResource OptionLabel}" />
                            <Slider Grid.Row="6" Grid.Column="1" x:Name="RainbowBri" Minimum="5" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Rainbow.Brightness, Mode=TwoWay}" IsEnabled="{Binding IsChecked, ElementName=RainbowUseBri}" />
                            <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=RainbowBri, StringFormat={}%{0:F0}}" />
                          </Grid>
                        </DockPanel>
                      </StackPanel>

                      <!-- Şömine -->
                      <StackPanel x:Name="OptFire" Visibility="Collapsed">
                        <DockPanel>
                          <Button Content="Varsayılana dön" Style="{StaticResource Small}" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,3" FontSize="11.5" Tag="Şömine" Click="ModeDefaults_Click" ToolTip="Bu modun ayarlarını sıfırla" />
                          <TextBlock Text="Şömine" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Titreyen sıcak ateş ışığı." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,8" />
                        <Border x:Name="FirePreview" Height="16" CornerRadius="8" Margin="0,0,0,10" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Grid.Row="0" Text="Yoğunluk" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="0" Grid.Column="1" x:Name="FireIntensity" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Fire.Intensity, Mode=TwoWay}" ToolTip="Titreme şiddeti" />
                          <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=FireIntensity, StringFormat={}%{0:F0}}" />

                          <TextBlock Grid.Row="1" Text="Hız" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="1" Grid.Column="1" x:Name="FireSpeed" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Fire.Speed, Mode=TwoWay}" />
                          <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=FireSpeed, StringFormat={}{0:F0} / 10}" />

                          <TextBlock Grid.Row="2" Text="Sıcaklık" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="2" Grid.Column="1" x:Name="FireWarmth" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Fire.Warmth, Mode=TwoWay}" ToolTip="Kor kırmızısından sarı aleve" ValueChanged="FireWarmth_Changed">
                            <Slider.Foreground>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#C1121F" Offset="0" />
                                <GradientStop Color="#FF7B00" Offset="0.5" />
                                <GradientStop Color="#FFD000" Offset="1" />
                              </LinearGradientBrush>
                            </Slider.Foreground>
                          </Slider>
                          <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=FireWarmth, StringFormat={}%{0:F0}}" />

                          <TextBlock Grid.Row="3" Text="Parlaklık" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="3" Grid.Column="1" x:Name="FireBrightness" Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Fire.Brightness, Mode=TwoWay}" />
                          <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=FireBrightness, StringFormat={}%{0:F0}}" />
                        </Grid>
                        <CheckBox Content="Kıvılcımlar" IsChecked="{Binding Fire.Sparks, Mode=TwoWay}" Margin="0,8,0,0" />
                        <TextBlock x:Name="FireNote" Text="" Visibility="Collapsed" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />
                      </StackPanel>

                      <!-- Spotify -->
                      <StackPanel x:Name="OptSpotify" Visibility="Collapsed">
                        <DockPanel>
                          <Button Content="Varsayılana dön" Style="{StaticResource Small}" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,3" FontSize="11.5" Tag="Spotify" Click="ModeDefaults_Click" ToolTip="Bu modun ayarlarını sıfırla" />
                          <TextBlock Text="Spotify" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="SpotifySubtitle" Text="Işık, çalan şarkının kapak rengini alır." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,8" />
                        <Border Style="{StaticResource Pill}" CornerRadius="14" Padding="10,8" Margin="0,0,0,10">
                          <DockPanel>
                            <Border x:Name="NowPlayingChip" Width="34" Height="34" CornerRadius="8" Background="#33FFFFFF" Margin="0,0,10,0" DockPanel.Dock="Left" />
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock x:Name="NowPlayingTitle" Text="Çalan yok" FontWeight="SemiBold" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                              <TextBlock x:Name="NowPlayingArtist" Text="Spotify’da bir şarkı başlat." FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </DockPanel>
                        </Border>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Grid.Row="0" Text="Parlaklık" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="0" Grid.Column="1" x:Name="SpotifyBri" Minimum="5" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Spotify.Brightness, Mode=TwoWay}" />
                          <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=SpotifyBri, StringFormat={}%{0:F0}}" />

                          <TextBlock Grid.Row="1" Text="Geçiş" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="1" Grid.Column="1" x:Name="SpotifyFade" Minimum="200" Maximum="5000" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding Spotify.TransitionMs, Mode=TwoWay}" />
                          <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=SpotifyFade, StringFormat={}{0:F0} ms}" />

                          <TextBlock Grid.Row="2" Text="Canlılık" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="2" Grid.Column="1" x:Name="SpotifySat" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Spotify.Saturation, Mode=TwoWay}" />
                          <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=SpotifySat, StringFormat={}%{0:F0}}" />
                        </Grid>
                        <CheckBox x:Name="SpotifyOnly" Content="Yalnızca Spotify" ToolTip="Kapalıyken diğer oynatıcılarla da çalışır" IsChecked="{Binding Spotify.OnlySpotify, Mode=TwoWay}" Margin="0,8,0,0" Click="SpotifyOnly_Click" />
                      </StackPanel>

                      <!-- Gün ışığı -->
                      <StackPanel x:Name="OptDaylight" Visibility="Collapsed">
                        <DockPanel>
                          <Button Content="Varsayılana dön" Style="{StaticResource Small}" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,3" FontSize="11.5" Tag="Gün ışığı" Click="ModeDefaults_Click" ToolTip="Bu modun ayarlarını sıfırla" />
                          <TextBlock Text="Gün ışığı" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Gün boyu serin ve parlak, akşam sıcak ve loş." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,8" />
                        <Grid Height="34" Margin="0,0,0,10">
                          <Border x:Name="DaylightBar" CornerRadius="9" Height="18" VerticalAlignment="Top" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" />
                          <Canvas x:Name="DaylightCanvas">
                            <Border x:Name="DaylightNow" Width="3" Height="24" CornerRadius="1.5" Background="{DynamicResource Text}" Canvas.Top="-3" />
                          </Canvas>
                          <DockPanel VerticalAlignment="Bottom">
                            <TextBlock Text="00" FontSize="9.5" Foreground="{DynamicResource Muted}" />
                            <TextBlock Text="24" FontSize="9.5" Foreground="{DynamicResource Muted}" DockPanel.Dock="Right" />
                            <TextBlock Text="12" FontSize="9.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                          </DockPanel>
                        </Grid>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Grid.Row="0" Text="Uyanış" Style="{StaticResource OptionLabel}" />
                          <TextBox Grid.Row="0" Grid.Column="1" x:Name="DayWake" Width="90" HorizontalAlignment="Left" Margin="0,4" MaxLength="5" LostFocus="DaylightTime_Commit" KeyDown="TimeBox_KeyDown" />
                          <TextBlock Grid.Row="1" Text="Yatış" Style="{StaticResource OptionLabel}" />
                          <TextBox Grid.Row="1" Grid.Column="1" x:Name="DaySleep" Width="90" HorizontalAlignment="Left" Margin="0,4" MaxLength="5" LostFocus="DaylightTime_Commit" KeyDown="TimeBox_KeyDown" />

                          <TextBlock Grid.Row="2" Text="En sıcak" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="2" Grid.Column="1" x:Name="DayMinK" Minimum="2200" Maximum="4000" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding Daylight.MinKelvin, Mode=TwoWay}" ValueChanged="Daylight_Changed" />
                          <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=DayMinK, StringFormat={}{0:F0} K}" />
                          <TextBlock Grid.Row="3" Text="En serin" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="3" Grid.Column="1" x:Name="DayMaxK" Minimum="3500" Maximum="6500" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding Daylight.MaxKelvin, Mode=TwoWay}" ValueChanged="Daylight_Changed" />
                          <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=DayMaxK, StringFormat={}{0:F0} K}" />

                          <TextBlock Grid.Row="4" Text="En düşük" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="4" Grid.Column="1" x:Name="DayMinB" Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Daylight.MinBrightness, Mode=TwoWay}" ValueChanged="Daylight_Changed" />
                          <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=DayMinB, StringFormat={}%{0:F0}}" />
                          <TextBlock Grid.Row="5" Text="En yüksek" Style="{StaticResource OptionLabel}" />
                          <Slider Grid.Row="5" Grid.Column="1" x:Name="DayMaxB" Minimum="30" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Daylight.MaxBrightness, Mode=TwoWay}" ValueChanged="Daylight_Changed" />
                          <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=DayMaxB, StringFormat={}%{0:F0}}" />
                        </Grid>
                      </StackPanel>

                      <DockPanel Margin="0,12,0,0">
                        <Button x:Name="ModeStartButton" Content="Başlat" Style="{StaticResource Primary}" DockPanel.Dock="Right" Margin="10,0,0,0" MinWidth="110" Click="ModeStart_Click" />
                        <TextBlock x:Name="LiveText" Text="" FontSize="12" Foreground="{DynamicResource ModeText}" VerticalAlignment="Center" />
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </ContentControl>

            <!-- Zamanlayıcı -->
            <ContentControl x:Name="TimerCard" Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="TimerChev" Style="{StaticResource Chevron}" DockPanel.Dock="Right" Tag="timer" Click="Section_Click" />
                  <Border Style="{StaticResource Pill}" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="10,4">
                    <TextBlock x:Name="TimerBadge" Text="KAPALI" Foreground="{DynamicResource ModeText}" FontSize="10" FontWeight="SemiBold" TextWrapping="NoWrap" />
                  </Border>
                  <Button Style="{StaticResource HeaderButton}" Tag="timer" Click="Section_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><TextBlock Text="Zamanlayıcı" FontSize="22" FontWeight="SemiBold" TextWrapping="NoWrap" /></Button>
                </DockPanel>
                <StackPanel x:Name="TimerBody">

                <!-- Uyku sayacı -->
                <Border Style="{StaticResource Pill}" CornerRadius="16" Padding="14,10" Margin="0,12,0,10">
                  <StackPanel>
                    <DockPanel>
                      <Button x:Name="SleepChev" Style="{StaticResource Chevron}" DockPanel.Dock="Right" Tag="sleep" Click="Section_Click" />
                      <TextBlock x:Name="SleepRemaining" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentSoft}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                      <Button Style="{StaticResource HeaderButton}" Tag="sleep" Click="Section_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel>
                        <TextBlock Text="Uyku sayacı" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Yavaşça kısılır, sonra kapanır." FontSize="11" Foreground="{DynamicResource Muted}" />
                      </StackPanel></Button>
                    </DockPanel>
                    <WrapPanel x:Name="SleepBody" Margin="0,10,0,0">
                      <Button Content="15 dk" Tag="15" Style="{StaticResource Small}" Margin="0,0,6,6" Click="SleepPreset_Click" />
                      <Button Content="30 dk" Tag="30" Style="{StaticResource Small}" Margin="0,0,6,6" Click="SleepPreset_Click" />
                      <Button Content="45 dk" Tag="45" Style="{StaticResource Small}" Margin="0,0,6,6" Click="SleepPreset_Click" />
                      <Button Content="60 dk" Tag="60" Style="{StaticResource Small}" Margin="0,0,6,6" Click="SleepPreset_Click" />
                      <TextBox x:Name="SleepCustom" Width="60" Text="90" MaxLength="3" Margin="0,0,6,6" Padding="8,4" ToolTip="Dakika" KeyDown="SleepCustom_KeyDown" />
                      <Button Content="Başlat" Style="{StaticResource Small}" Margin="0,0,6,6" Click="SleepCustom_Click" />
                      <Button x:Name="SleepCancelButton" Content="İptal" Style="{StaticResource Small}" Margin="0,0,0,6" Click="SleepCancel_Click" Visibility="Collapsed" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <!-- Uyandırma -->
                <Border Style="{StaticResource Pill}" CornerRadius="16" Padding="14,10" Margin="0,0,0,10">
                  <StackPanel>
                    <DockPanel>
                      <Button x:Name="WakeChev" Style="{StaticResource Chevron}" DockPanel.Dock="Right" Tag="wake" Click="Section_Click" />
                      <ToggleButton x:Name="WakeToggle" Style="{StaticResource Switch}" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Wake_Changed" />
                      <Button Style="{StaticResource HeaderButton}" Tag="wake" Click="Section_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel>
                        <TextBlock Text="Uyandırma" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Gün doğumu gibi: sıcak ve loştan parlak beyaza." FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                      </StackPanel></Button>
                    </DockPanel>
                    <StackPanel x:Name="WakeBody">
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="Saat" Style="{StaticResource OptionLabel}" />
                      <TextBox Grid.Column="1" x:Name="WakeTime" Width="86" HorizontalAlignment="Left" MaxLength="5" Margin="0,4" LostFocus="Wake_Changed" KeyDown="TimeBox_KeyDown" />
                      <TextBlock Grid.Row="1" Text="Günler" Style="{StaticResource OptionLabel}" />
                      <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="WakeDays" Margin="0,6,0,0" />
                      <TextBlock Grid.Row="2" Text="Süre" Style="{StaticResource OptionLabel}" />
                      <Slider Grid.Row="2" Grid.Column="1" x:Name="WakeFade" Minimum="5" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True" Value="20" ValueChanged="WakeSlider_Changed" />
                      <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=WakeFade, StringFormat={}{0:F0} dk}" />
                      <TextBlock Grid.Row="3" Text="Parlaklık" Style="{StaticResource OptionLabel}" />
                      <Slider Grid.Row="3" Grid.Column="1" x:Name="WakeBri" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="100" ValueChanged="WakeSlider_Changed" />
                      <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=WakeBri, StringFormat={}%{0:F0}}" />
                    </Grid>
                    <TextBlock x:Name="WakeNext" Text="" FontSize="11" Foreground="{DynamicResource ModeText}" Margin="0,4,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Programlar -->
                <Border Style="{StaticResource Pill}" CornerRadius="16" Padding="14,10">
                  <StackPanel>
                    <DockPanel>
                      <Button x:Name="ProgramsChev" Style="{StaticResource Chevron}" DockPanel.Dock="Right" Tag="programs" Click="Section_Click" />
                      <Button Content="+ Ekle" Style="{StaticResource Small}" DockPanel.Dock="Right" Margin="0" VerticalAlignment="Center" Click="ScheduleAdd_Click" />
                      <Button Style="{StaticResource HeaderButton}" Tag="programs" Click="Section_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel>
                        <TextBlock Text="Programlar" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Belirli saatte aç, kapat veya sahne uygula." FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                      </StackPanel></Button>
                    </DockPanel>
                    <StackPanel x:Name="ProgramsBody">
                    <StackPanel x:Name="ScheduleList" Margin="0,8,0,0" />
                    <TextBlock x:Name="ScheduleEmpty" Text="Henüz program yok." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                </StackPanel>
              </StackPanel>
            </ContentControl>

            <!-- Bildirim ışığı -->
            <ContentControl x:Name="NotifyCard" Style="{StaticResource GlassCard}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="NotifyChev" Style="{StaticResource Chevron}" DockPanel.Dock="Right" Tag="notify" Click="Section_Click" />
                  <ToggleButton x:Name="NotifyToggle" Style="{StaticResource Switch}" DockPanel.Dock="Right" VerticalAlignment="Center" Click="NotifyToggle_Click" />
                  <Button Style="{StaticResource HeaderButton}" Tag="notify" Click="Section_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel>
                    <TextBlock Text="Bildirim ışığı" FontSize="22" FontWeight="SemiBold" TextWrapping="NoWrap" />
                    <TextBlock x:Name="NotifyStatus" Text="Kapalı" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                  </StackPanel></Button>
                </DockPanel>
                <StackPanel x:Name="NotifyBody">
                <WrapPanel Margin="0,10,0,0">
                  <CheckBox Margin="0,4,14,4" IsChecked="{Binding Notify.Discord, Mode=TwoWay}"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="#5865F2" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="Discord" /></StackPanel></CheckBox>
                  <CheckBox Margin="0,4,14,4" IsChecked="{Binding Notify.WhatsApp, Mode=TwoWay}"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="#25D366" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="WhatsApp" /></StackPanel></CheckBox>
                  <CheckBox Margin="0,4,14,4" IsChecked="{Binding Notify.Teams, Mode=TwoWay}"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="#7B83EB" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="Teams" /></StackPanel></CheckBox>
                  <CheckBox Margin="0,4,14,4" IsChecked="{Binding Notify.Outlook, Mode=TwoWay}"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="#0F6CBD" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="Outlook" /></StackPanel></CheckBox>
                  <CheckBox Margin="0,4,14,4" IsChecked="{Binding Notify.Others, Mode=TwoWay}" Content="Diğerleri" />
                </WrapPanel>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Renk" Style="{StaticResource OptionLabel}" />
                  <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <CheckBox x:Name="NotifyAppColor" Content="Uygulama rengi" IsChecked="{Binding Notify.UseAppColor, Mode=TwoWay}" Margin="0,4,12,4" Click="NotifyColor_Changed" />
                    <Border x:Name="NotifyChip" Width="24" Height="24" CornerRadius="12" BorderBrush="#59FFFFFF" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="NotifyHex" Width="84" MaxLength="7" Padding="8,4" VerticalAlignment="Center" LostFocus="NotifyColor_Changed" KeyDown="TimeBox_KeyDown" />
                  </StackPanel>
                  <TextBlock Grid.Row="1" Text="Yanıp sönme" Style="{StaticResource OptionLabel}" />
                  <Slider Grid.Row="1" Grid.Column="1" x:Name="NotifyCount" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Notify.Count, Mode=TwoWay}" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource OptionValue}" Text="{Binding Value, ElementName=NotifyCount, StringFormat={}{0:F0} kez}" />
                </Grid>
                <DockPanel Margin="0,4,0,0">
                  <Button Content="Dene" Style="{StaticResource Small}" DockPanel.Dock="Right" Margin="0" Click="NotifyTest_Click" />
                  <CheckBox Content="Sonra önceki ışığa dön" IsChecked="{Binding Notify.Restore, Mode=TwoWay}" />
                </DockPanel>
                </StackPanel>
              </StackPanel>
            </ContentControl>

          </StackPanel>
        </Grid>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
