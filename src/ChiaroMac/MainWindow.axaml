<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:HueStudio.Ui"
        x:Class="HueStudio.MainWindow"
        Title="Chiaro"
        Width="1060" Height="880" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/chiaro-256.png"
        Background="Transparent"
        FontSize="12">
  <Grid x:Name="Root">
    <!-- Arka plan: koyu/açık degrade + ampul renginde hafif ışık lekeleri -->
    <Border x:Name="BgGradient">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#1B1F2E" />
          <GradientStop Offset="1" Color="#262236" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Canvas IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse x:Name="BlobLive" Width="620" Height="520" Canvas.Left="-180" Canvas.Top="-200" Opacity="0.55">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Offset="0" Color="#88FF9A3C" />
            <GradientStop Offset="1" Color="#00FF9A3C" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="700" Height="600" Canvas.Left="620" Canvas.Top="420" Opacity="0.5">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Offset="0" Color="#554E5BFF" />
            <GradientStop Offset="1" Color="#004E5BFF" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
    </Canvas>

    <DockPanel Margin="16,10,16,14">
      <!-- Başlık -->
      <Grid DockPanel.Dock="Top" x:Name="Header" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,0,0,10" Height="40">
        <Border x:Name="TrafficLightSpace" Grid.Column="0" Width="0" />
        <Image Grid.Column="1" Source="/Assets/logo-128.png" Width="30" Height="30" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Spacing="10">
          <TextBlock Text="Chiaro" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="pillbox" Background="{DynamicResource PillBg}" BorderBrush="{DynamicResource PillBorder}" BorderThickness="1" CornerRadius="10" Padding="10,5">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse x:Name="HeaderDot" Width="7" Height="7" Fill="#8A93A6" VerticalAlignment="Center" />
              <TextBlock x:Name="HeaderStatus" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Button Classes="pill" x:Name="UpdateButton" ui:Tr.Key="hdr_check_updates" ui:Tr.Tip="hdr_check_updates_tip" Click="CheckUpdates_Click" />
          <Button Classes="pill" x:Name="MiniButton" ui:Tr.Key="hdr_mini" ui:Tr.Tip="hdr_mini_tip" Click="Mini_Click" />
          <Button Classes="pill" x:Name="HideButton" ui:Tr.Key="hdr_hide" ui:Tr.Tip="hdr_hide_tip" Click="Hide_Click" />
        </StackPanel>
      </Grid>

      <!-- Durum çubuğu -->
      <Border DockPanel.Dock="Top" Classes="card" Padding="16,8" Margin="0,0,0,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" FontWeight="Bold" FontSize="12" />
            <TextBlock x:Name="DetailText" Classes="sub" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="pill" x:Name="CancelButton" ui:Tr.Key="cancel" Click="Cancel_Click" IsVisible="False" />
            <Button Classes="pill" x:Name="RefreshButton" ui:Tr.Key="refresh" Click="Refresh_Click" />
            <Button Classes="pill" x:Name="DisconnectButton" ui:Tr.Key="disconnect" Click="Disconnect_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Alt çubuk -->
      <Border DockPanel.Dock="Bottom" Classes="card" Background="{DynamicResource DockBg}" Margin="0,4,0,0" Padding="14,8">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
          <Button Classes="pill" Width="38" Height="38" Padding="0" CornerRadius="12" Click="PowerQuick_Click" ui:Tr.Tip="light_toggle">
            <TextBlock x:Name="DockBulb" Text="💡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Ellipse Grid.Column="1" x:Name="DockColor" Width="26" Height="26" Margin="12,0,10,0" Fill="#FF8C1A" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="150">
            <TextBlock x:Name="DockTitle" FontWeight="Bold" FontSize="12" />
            <TextBlock x:Name="DockSub" Classes="sub" />
          </StackPanel>
          <StackPanel Grid.Column="3" Margin="18,0,0,0" VerticalAlignment="Center">
            <TextBlock Classes="caps" ui:Tr.Key="favorites_upper" Margin="0,0,0,3" />
            <WrapPanel x:Name="DockFavorites" />
          </StackPanel>
          <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="10,0,14,0">
            <TextBlock Classes="sub" ui:Tr.Key="brightness" FontSize="10" />
            <TextBlock x:Name="DockBrightness" FontWeight="Bold" FontSize="13" />
          </StackPanel>
          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Button Classes="pill" x:Name="ThemeButton" Click="Theme_Click" ui:Tr.Tip="theme_tip" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="VersionText" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
              <TextBlock Classes="sub" ui:Tr.Key="credits" FontSize="9" HorizontalAlignment="Right" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer x:Name="MainScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="410,14,*" Margin="0,0,14,0">
          <!-- ===================== SOL SÜTUN ===================== -->
          <StackPanel Grid.Column="0">
            <!-- Cihaz -->
            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h1" ui:Tr.Key="device" />
                  <TextBlock Grid.Column="1" Classes="sub" ui:Tr.Key="device_hint" VerticalAlignment="Center" />
                </Grid>
                <ComboBox x:Name="Devices" HorizontalAlignment="Stretch" ui:Tr.Key="select_bulb" SelectionChanged="Devices_SelectionChanged" />
                <TextBlock x:Name="ScanSummary" Classes="sub" />
                <Grid ColumnDefinitions="*,8,*">
                  <Button Classes="pill" x:Name="ScanButton" HorizontalAlignment="Stretch" ui:Tr.Key="scan" Click="Scan_Click" />
                  <Button Grid.Column="2" Classes="primary" x:Name="ConnectButton" HorizontalAlignment="Stretch" ui:Tr.Key="connect" Click="Connect_Click" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Ampul -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Classes="caps" ui:Tr.Key="bulb_upper" />
                    <TextBlock x:Name="LightTitle" Classes="h1" Text="Hue" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" x:Name="PowerToggle" OnContent="" OffContent="" VerticalAlignment="Center" Click="PowerToggle_Click" />
                </Grid>
                <!-- Ampul görseli -->
                <Grid Height="170" HorizontalAlignment="Center" Width="220">
                  <Ellipse x:Name="Halo" Width="200" Height="200" Margin="0,-20,0,0" Opacity="0.9">
                    <Ellipse.Fill>
                      <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#00FFFFFF" />
                        <GradientStop Offset="0.45" Color="#00FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                      </RadialGradientBrush>
                    </Ellipse.Fill>
                  </Ellipse>
                  <Canvas Width="80" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-14,0,0">
                    <Path x:Name="BulbGlass" Fill="#3A4256" Stroke="#30FFFFFF" StrokeThickness="1.2"
                          Data="M40,2 C18,2 2,18 2,39 C2,53 9,62 16,70 C21,76 24,81 25,88 L55,88 C56,81 59,76 64,70 C71,62 78,53 78,39 C78,18 62,2 40,2 Z" />
                    <Path x:Name="Filament" Stroke="#8090A0" StrokeThickness="2.2" StrokeLineCap="Round"
                          Data="M31,86 L31,58 L36,50 L40,58 L44,50 L49,58 L49,86" />
                    <Path Fill="#9EA6B4" Data="M25,90 L55,90 Q56,90 56,92 L56,96 Q56,98 54,98 L26,98 Q24,98 24,96 L24,92 Q24,90 25,90 Z" />
                    <Path Fill="#868E9C" Data="M26,100 L54,100 Q55,100 55,102 L55,104 Q55,106 53,106 L27,106 Q25,106 25,104 L25,102 Q25,100 26,100 Z" />
                    <Path Fill="#6E7684" Data="M32,108 L48,108 Q46,112 40,112 Q34,112 32,108 Z" />
                  </Canvas>
                  <TextBlock x:Name="StateText" Classes="sub" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </Grid>
                <Border Classes="inner" x:Name="BrightnessPanel">
                  <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="h2" ui:Tr.Key="brightness" />
                      <TextBlock Grid.Column="1" x:Name="BrightnessLabel" Classes="value" />
                    </Grid>
                    <Slider x:Name="BrightnessSlider" Minimum="1" Maximum="100" Value="72" />
                    <TextBlock x:Name="BrightnessHint" Classes="sub" IsVisible="False" />
                  </StackPanel>
                </Border>
                <Border Classes="inner" x:Name="TemperaturePanel">
                  <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="h2" ui:Tr.Key="white_tone" />
                      <TextBlock Grid.Column="1" x:Name="TemperatureLabel" Classes="value" />
                    </Grid>
                    <Grid>
                      <Border Height="4" CornerRadius="2" Margin="10,0" VerticalAlignment="Center">
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Offset="0" Color="#FFB46B" />
                            <GradientStop Offset="0.45" Color="#FFF1DE" />
                            <GradientStop Offset="1" Color="#CFE0FF" />
                          </LinearGradientBrush>
                        </Border.Background>
                      </Border>
                      <Slider x:Name="TemperatureSlider" Classes="white" Minimum="2200" Maximum="6500" Value="3000" IsSnapToTickEnabled="True" TickFrequency="50" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*">
                      <TextBlock Classes="sub" ui:Tr.Key="warm" FontSize="10" />
                      <TextBlock Grid.Column="1" Classes="sub" ui:Tr.Key="cool" FontSize="10" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock x:Name="TemperatureHint" Classes="sub" IsVisible="False" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- Renkler -->
            <Border Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Classes="h1" ui:Tr.Key="colors" />
                <TextBlock x:Name="ColorHint" Classes="sub" IsVisible="False" />
                <StackPanel x:Name="PaletteHost" Spacing="2" />
                <Border Classes="inner" Margin="0,6,0,0">
                  <Grid ColumnDefinitions="Auto,*">
                    <ui:ColorWheel x:Name="Wheel" Width="150" Height="150" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Classes="caps" ui:Tr.Key="custom_upper" />
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse x:Name="CustomPreview" Width="34" Height="34" Fill="#FF8C1A" />
                        <StackPanel>
                          <TextBlock Classes="sub" ui:Tr.Key="hex" />
                          <TextBox x:Name="HexBox" Width="110" Text="#FF8C1A" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" />
                        </StackPanel>
                      </StackPanel>
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="label" ui:Tr.Key="saturation" Margin="0,0,8,0" />
                        <Slider Grid.Column="1" x:Name="SatSlider" Minimum="0" Maximum="100" Value="90" />
                        <TextBlock Grid.Column="2" x:Name="SatLabel" Classes="label" Margin="6,0,0,0" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="pill" ui:Tr.Key="fav_button" ui:Tr.Tip="fav_add_tip" Click="AddFavorite_Click" />
                        <Button Classes="primary" ui:Tr.Key="apply" Click="ApplyCustom_Click" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
                <TextBlock Classes="caps" ui:Tr.Key="recent_upper" Margin="0,8,0,2" />
                <WrapPanel x:Name="RecentHost" />
                <TextBlock x:Name="RecentEmpty" Classes="sub" ui:Tr.Key="none_yet" />
              </StackPanel>
            </Border>

            <!-- Ayarlar -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h1" x:Name="SettingsTitle" ui:Tr.Key="settings_title" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="label" ui:Tr.Key="language_label" />
                  <ComboBox Grid.Column="1" x:Name="LanguageBox" Width="170" SelectionChanged="Language_Changed">
                    <ComboBoxItem ui:Tr.Key="lang_auto" />
                    <ComboBoxItem ui:Tr.Key="lang_tr" />
                    <ComboBoxItem ui:Tr.Key="lang_en" />
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="label" ui:Tr.Key="mac_appearance" />
                  <Button Grid.Column="1" Classes="pill" x:Name="ThemeButton2" Width="170" Click="Theme_Click" />
                </Grid>
                <CheckBox x:Name="AutostartBox" ui:Tr.Key="autostart" ui:Tr.Tip="autostart_tip" Click="Autostart_Click" />
                <CheckBox x:Name="LightOnStartupBox" ui:Tr.Key="light_on_startup" Margin="26,0,0,0" ToolTip.ShowOnDisabled="True" Click="LightOnStartup_Click" />
                <CheckBox x:Name="RestoreLastModeBox" ui:Tr.Key="restore_last_mode" Margin="26,0,0,0" ToolTip.ShowOnDisabled="True" Click="RestoreLastMode_Click" />
                <CheckBox x:Name="AutoUpdateBox" ui:Tr.Key="mac_upd_auto" Click="AutoUpdate_Click" />
                <WrapPanel>
                  <Button Classes="pill" Margin="0,0,6,6" ui:Tr.Key="help" Click="Help_Click" />
                  <Button Classes="pill" Margin="0,0,6,6" ui:Tr.Key="mac_bt_privacy" ui:Tr.Tip="mac_bt_privacy_tip" Click="BtSettings_Click" />
                  <Button Classes="pill" Margin="0,0,6,6" ui:Tr.Key="forget" Click="Forget_Click" />
                  <Button Classes="pill" Margin="0,0,6,6" ui:Tr.Key="mac_open_log" ui:Tr.Tip="mac_open_log_tip" Click="OpenLog_Click" />
                  <Button Classes="pill" Margin="0,0,6,6" ui:Tr.Key="about" Click="About_Click" />
                </WrapPanel>
                <TextBlock x:Name="MetaText" Classes="sub" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ===================== SAĞ SÜTUN ===================== -->
          <StackPanel Grid.Column="2">
            <!-- Sahneler -->
            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Classes="h1" ui:Tr.Key="scenes" />
                    <TextBlock Classes="sub" x:Name="ScenesHint" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                    <Button Classes="pill" ui:Tr.Key="scene_save" ui:Tr.Tip="scene_save_tip" Click="SceneSave_Click" />
                    <Button Classes="pill" Content="•••" x:Name="ScenesMore" Click="ScenesMore_Click" />
                  </StackPanel>
                </Grid>
                <WrapPanel x:Name="ScenesHost" />
              </StackPanel>
            </Border>

            <!-- Modlar -->
            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h1" ui:Tr.Key="modes" />
                  <Border Grid.Column="1" x:Name="ModeBadge" Background="{DynamicResource BadgeGreenBg}" CornerRadius="8" Padding="8,2" VerticalAlignment="Center" IsVisible="False">
                    <TextBlock x:Name="ModeBadgeText" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BadgeGreenFg}" />
                  </Border>
                </Grid>
                <UniformGrid x:Name="ModeTiles" Columns="4" />
                <Border Classes="inner">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock x:Name="ModeTitle" Classes="h2" />
                        <TextBlock x:Name="ModeDesc" Classes="sub" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="pill" x:Name="ModeReset" ui:Tr.Key="restore_defaults" ui:Tr.Tip="restore_defaults_tip" Click="ModeReset_Click" VerticalAlignment="Top" />
                    </Grid>

                    <!-- Ekran -->
                    <Grid x:Name="ScreenOptions" ColumnDefinitions="110,*,124" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" IsVisible="False">
                      <TextBlock Classes="label" ui:Tr.Key="update_word" />
                      <Slider Grid.Column="1" x:Name="ScInterval" Minimum="50" Maximum="1000" />
                      <TextBlock Grid.Column="2" x:Name="ScIntervalLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <TextBlock Grid.Row="1" Classes="label" ui:Tr.Key="area" />
                      <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ScArea" HorizontalAlignment="Stretch" Margin="0,2" />
                      <TextBlock Grid.Row="2" Classes="label" ui:Tr.Key="monitor" />
                      <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ScMonitor" HorizontalAlignment="Stretch" Margin="0,2" />
                      <TextBlock Grid.Row="3" Classes="label" ui:Tr.Key="smoothing" />
                      <Slider Grid.Row="3" Grid.Column="1" x:Name="ScSmooth" Minimum="0" Maximum="95" />
                      <TextBlock Grid.Row="3" Grid.Column="2" x:Name="ScSmoothLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <TextBlock Grid.Row="4" Classes="label" ui:Tr.Key="method" />
                      <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ScMethod" HorizontalAlignment="Stretch" Margin="0,2" />
                      <TextBlock Grid.Row="5" Classes="label" ui:Tr.Key="vividness" />
                      <Slider Grid.Row="5" Grid.Column="1" x:Name="ScBoost" Minimum="0" Maximum="100" />
                      <TextBlock Grid.Row="5" Grid.Column="2" x:Name="ScBoostLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <CheckBox Grid.Row="6" Grid.ColumnSpan="3" x:Name="ScIgnoreDark" ui:Tr.Key="ignore_dark" />
                      <CheckBox Grid.Row="7" Grid.ColumnSpan="3" x:Name="ScFollow" ui:Tr.Key="follow_brightness" />
                    </Grid>

                    <!-- Ses -->
                    <Grid x:Name="AudioOptions" ColumnDefinitions="110,*,90" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" IsVisible="False">
                      <TextBlock Classes="label" ui:Tr.Key="mac_audio_source" ui:Tr.Tip="mac_audio_source_tip" />
                      <ComboBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="AuSource" HorizontalAlignment="Stretch" Margin="0,2" />
                      <TextBlock Grid.Row="1" Classes="label" ui:Tr.Key="sensitivity" />
                      <Slider Grid.Row="1" Grid.Column="1" x:Name="AuSens" Minimum="1" Maximum="12" />
                      <TextBlock Grid.Row="1" Grid.Column="2" x:Name="AuSensLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <TextBlock Grid.Row="2" Classes="label" ui:Tr.Key="response" />
                      <Slider Grid.Row="2" Grid.Column="1" x:Name="AuAttack" Minimum="10" Maximum="100" />
                      <TextBlock Grid.Row="2" Grid.Column="2" x:Name="AuAttackLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <TextBlock Grid.Row="3" Classes="label" ui:Tr.Key="decay" />
                      <Slider Grid.Row="3" Grid.Column="1" x:Name="AuRelease" Minimum="5" Maximum="90" />
                      <TextBlock Grid.Row="3" Grid.Column="2" x:Name="AuReleaseLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <TextBlock Grid.Row="4" Classes="label" ui:Tr.Key="min" />
                      <Slider Grid.Row="4" Grid.Column="1" x:Name="AuMin" Minimum="1" Maximum="60" />
                      <TextBlock Grid.Row="4" Grid.Column="2" x:Name="AuMinLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <TextBlock Grid.Row="5" Classes="label" ui:Tr.Key="max" />
                      <Slider Grid.Row="5" Grid.Column="1" x:Name="AuMax" Minimum="20" Maximum="100" />
                      <TextBlock Grid.Row="5" Grid.Column="2" x:Name="AuMaxLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <TextBlock Grid.Row="6" Classes="label" ui:Tr.Key="update_word" />
                      <Slider Grid.Row="6" Grid.Column="1" x:Name="AuInterval" Minimum="100" Maximum="600" />
                      <TextBlock Grid.Row="6" Grid.Column="2" x:Name="AuIntervalLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                    </Grid>

                    <!-- Spotify -->
                    <StackPanel x:Name="SpotifyOptions" Spacing="8" IsVisible="False">
                      <Border Classes="inner" Padding="10,8">
                        <Grid ColumnDefinitions="Auto,*">
                          <Border x:Name="NowPlayingChip" Width="34" Height="34" CornerRadius="8" Background="#33FFFFFF" Margin="0,0,10,0" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="NowPlayingTitle" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="NowPlayingArtist" Classes="sub" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Border>
                      <Grid ColumnDefinitions="110,*,90" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Classes="label" ui:Tr.Key="brightness" />
                        <Slider Grid.Column="1" x:Name="SpBri" Minimum="5" Maximum="100" />
                        <TextBlock Grid.Column="2" x:Name="SpBriLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                        <TextBlock Grid.Row="1" Classes="label" ui:Tr.Key="transition" />
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="SpFade" Minimum="200" Maximum="5000" />
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SpFadeLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                        <TextBlock Grid.Row="2" Classes="label" ui:Tr.Key="vividness" />
                        <Slider Grid.Row="2" Grid.Column="1" x:Name="SpSat" Minimum="0" Maximum="100" />
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="SpSatLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                        <CheckBox Grid.Row="3" Grid.ColumnSpan="3" x:Name="SpOnly" ui:Tr.Key="spotify_only" ui:Tr.Tip="spotify_only_tip" />
                      </Grid>
                    </StackPanel>

                    <!-- İzin uyarısı -->
                    <Border x:Name="PermissionPanel" Classes="inner" Padding="10,8" IsVisible="False" BorderBrush="#66FF9F0A" BorderThickness="1">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="PermissionText" Classes="sub" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Classes="pill" x:Name="PermissionButton" Click="PermissionButton_Click" VerticalAlignment="Center" />
                      </Grid>
                    </Border>

                    <!-- Gökkuşağı -->
                    <Grid x:Name="RainbowOptions" ColumnDefinitions="110,*,70" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" IsVisible="False">
                      <TextBlock Classes="label" ui:Tr.Key="direction" />
                      <ComboBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="RbDirection" HorizontalAlignment="Stretch" Margin="0,2" />
                      <TextBlock Grid.Row="1" Classes="label" ui:Tr.Key="palette" />
                      <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="RbPalette" HorizontalAlignment="Stretch" Margin="0,2" />
                      <TextBlock Grid.Row="2" Classes="label" ui:Tr.Key="cycle_time" ui:Tr.Tip="cycle_time_tip" />
                      <Slider Grid.Row="2" Grid.Column="1" x:Name="RbCycle" Minimum="4" Maximum="120" IsDirectionReversed="True" />
                      <TextBlock Grid.Row="2" Grid.Column="2" x:Name="RbCycleLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <TextBlock Grid.Row="3" Classes="label" ui:Tr.Key="saturation" />
                      <Slider Grid.Row="3" Grid.Column="1" x:Name="RbSat" Minimum="10" Maximum="100" />
                      <TextBlock Grid.Row="3" Grid.Column="2" x:Name="RbSatLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <CheckBox Grid.Row="4" Grid.ColumnSpan="3" x:Name="RbUseBri" ui:Tr.Key="fixed_brightness" />
                      <Slider Grid.Row="5" Grid.Column="1" x:Name="RbBri" Minimum="1" Maximum="100" />
                      <TextBlock Grid.Row="5" Grid.Column="2" x:Name="RbBriLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                    </Grid>

                    <!-- Şömine -->
                    <Grid x:Name="FireOptions" ColumnDefinitions="110,*,70" RowDefinitions="Auto,Auto,Auto,Auto,Auto" IsVisible="False">
                      <TextBlock Classes="label" ui:Tr.Key="intensity" ui:Tr.Tip="intensity_tip" />
                      <Slider Grid.Column="1" x:Name="FireIntensity" Minimum="0" Maximum="100" />
                      <TextBlock Grid.Column="2" x:Name="FireIntensityLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <TextBlock Grid.Row="1" Classes="label" ui:Tr.Key="speed" />
                      <Slider Grid.Row="1" Grid.Column="1" x:Name="FireSpeed" Minimum="1" Maximum="10" />
                      <TextBlock Grid.Row="1" Grid.Column="2" x:Name="FireSpeedLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <TextBlock Grid.Row="2" Classes="label" ui:Tr.Key="temperature" ui:Tr.Tip="temperature_tip" />
                      <Slider Grid.Row="2" Grid.Column="1" x:Name="FireWarmth" Minimum="0" Maximum="100" />
                      <TextBlock Grid.Row="2" Grid.Column="2" x:Name="FireWarmthLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <TextBlock Grid.Row="3" Classes="label" ui:Tr.Key="brightness" />
                      <Slider Grid.Row="3" Grid.Column="1" x:Name="FireBri" Minimum="10" Maximum="100" />
                      <TextBlock Grid.Row="3" Grid.Column="2" x:Name="FireBriLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <CheckBox Grid.Row="4" Grid.ColumnSpan="3" x:Name="FireSparks" ui:Tr.Key="sparks" />
                    </Grid>

                    <!-- Gün ışığı -->
                    <Grid x:Name="DaylightOptions" ColumnDefinitions="110,*,70" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" IsVisible="False">
                      <TextBlock Classes="label" ui:Tr.Key="wake_time" />
                      <TextBox Grid.Column="1" x:Name="DlWake" Width="80" HorizontalAlignment="Left" Margin="0,2" LostFocus="DaylightTime_LostFocus" />
                      <TextBlock Grid.Row="1" Classes="label" ui:Tr.Key="bed_time" />
                      <TextBox Grid.Row="1" Grid.Column="1" x:Name="DlSleep" Width="80" HorizontalAlignment="Left" Margin="0,2" LostFocus="DaylightTime_LostFocus" />
                      <TextBlock Grid.Row="2" Classes="label" ui:Tr.Key="warmest" />
                      <Slider Grid.Row="2" Grid.Column="1" x:Name="DlMinK" Minimum="2200" Maximum="4000" />
                      <TextBlock Grid.Row="2" Grid.Column="2" x:Name="DlMinKLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <TextBlock Grid.Row="3" Classes="label" ui:Tr.Key="coolest" />
                      <Slider Grid.Row="3" Grid.Column="1" x:Name="DlMaxK" Minimum="4000" Maximum="6500" />
                      <TextBlock Grid.Row="3" Grid.Column="2" x:Name="DlMaxKLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <TextBlock Grid.Row="4" Classes="label" ui:Tr.Key="min" />
                      <Slider Grid.Row="4" Grid.Column="1" x:Name="DlMinB" Minimum="1" Maximum="60" />
                      <TextBlock Grid.Row="4" Grid.Column="2" x:Name="DlMinBLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <TextBlock Grid.Row="5" Classes="label" ui:Tr.Key="max" />
                      <Slider Grid.Row="5" Grid.Column="1" x:Name="DlMaxB" Minimum="20" Maximum="100" />
                      <TextBlock Grid.Row="5" Grid.Column="2" x:Name="DlMaxBLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                    </Grid>

                    <Border x:Name="RainbowBar" Height="8" CornerRadius="4" IsVisible="False" />

                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock x:Name="LiveText" Classes="sub" VerticalAlignment="Center" Foreground="{DynamicResource BadgeGreenFg}" />
                      <Button Grid.Column="1" Classes="primary" x:Name="ModeStart" MinWidth="90" Click="ModeStart_Click" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- Zamanlayıcı -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h1" ui:Tr.Key="timer" />
                  <Border Grid.Column="1" x:Name="TimerBadge" Background="{DynamicResource BadgeGreenBg}" CornerRadius="8" Padding="8,2" VerticalAlignment="Center" IsVisible="False">
                    <TextBlock x:Name="TimerBadgeText" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BadgeGreenFg}" />
                  </Border>
                </Grid>
                <!-- Uyku sayacı -->
                <Border Classes="inner">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Classes="h2" ui:Tr.Key="sleep_timer" />
                        <TextBlock Classes="sub" ui:Tr.Key="sleep_desc" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" x:Name="SleepRemaining" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextAccent}" VerticalAlignment="Center" />
                    </Grid>
                    <WrapPanel>
                      <Button Classes="pill" Margin="0,0,6,0" ui:Tr.Key="min_15" Tag="15" Click="SleepPreset_Click" />
                      <Button Classes="pill" Margin="0,0,6,0" ui:Tr.Key="min_30" Tag="30" Click="SleepPreset_Click" />
                      <Button Classes="pill" Margin="0,0,6,0" ui:Tr.Key="min_45" Tag="45" Click="SleepPreset_Click" />
                      <Button Classes="pill" Margin="0,0,6,0" ui:Tr.Key="min_60" Tag="60" Click="SleepPreset_Click" />
                      <TextBox x:Name="SleepMinutesBox" Width="56" Margin="0,0,6,0" />
                      <Button Classes="pill" Margin="0,0,6,0" ui:Tr.Key="start" Click="SleepStart_Click" />
                      <Button Classes="pill" ui:Tr.Key="cancel" Click="SleepCancel_Click" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <!-- Uyandırma -->
                <Border Classes="inner">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Classes="h2" ui:Tr.Key="wake" />
                        <TextBlock Classes="sub" ui:Tr.Key="wake_desc" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" x:Name="WakeEnabled" OnContent="" OffContent="" Click="WakeEnabled_Click" />
                    </Grid>
                    <Grid ColumnDefinitions="90,*,70" RowDefinitions="Auto,Auto,Auto,Auto">
                      <TextBlock Classes="label" ui:Tr.Key="time" />
                      <TextBox Grid.Column="1" x:Name="WakeTime" Width="80" HorizontalAlignment="Left" Margin="0,2" LostFocus="WakeTime_LostFocus" />
                      <TextBlock Grid.Row="1" Classes="label" ui:Tr.Key="days" />
                      <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="WakeDays" Orientation="Horizontal" Margin="0,4" />
                      <TextBlock Grid.Row="2" Classes="label" ui:Tr.Key="duration" />
                      <Slider Grid.Row="2" Grid.Column="1" x:Name="WakeFade" Minimum="5" Maximum="60" />
                      <TextBlock Grid.Row="2" Grid.Column="2" x:Name="WakeFadeLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                      <TextBlock Grid.Row="3" Classes="label" ui:Tr.Key="brightness" />
                      <Slider Grid.Row="3" Grid.Column="1" x:Name="WakeBri" Minimum="10" Maximum="100" />
                      <TextBlock Grid.Row="3" Grid.Column="2" x:Name="WakeBriLabel" Classes="label" HorizontalAlignment="Right" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" />
                    </Grid>
                    <TextBlock x:Name="WakeNext" Classes="sub" Foreground="{DynamicResource BadgeGreenFg}" />
                  </StackPanel>
                </Border>
                <!-- Programlar -->
                <Border Classes="inner">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Classes="h2" ui:Tr.Key="programs" />
                        <TextBlock Classes="sub" ui:Tr.Key="programs_desc" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="pill" ui:Tr.Key="add" Click="AddSchedule_Click" VerticalAlignment="Top" />
                    </Grid>
                    <StackPanel x:Name="SchedulesHost" Spacing="8" />
                    <TextBlock x:Name="SchedulesEmpty" Classes="sub" ui:Tr.Key="no_programs" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
