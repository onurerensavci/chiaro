<Window xmlns:l="clr-namespace:HueStudio" x:Class="HueStudio.MiniBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chiaro Mini" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
  <Grid x:Name="Root" Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
  <Grid Grid.Row="1" x:Name="Surface" MouseLeftButtonDown="Drag">
    <Border CornerRadius="30" Background="{DynamicResource Backdrop}" Opacity="0.9">
      <Border.Effect>
        <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.35" Color="Black" RenderingBias="Performance" />
      </Border.Effect>
    </Border>
    <Border CornerRadius="30" Background="{DynamicResource Glass}" />
    <Border CornerRadius="30" Background="{DynamicResource GlassShine}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" IsHitTestVisible="False" />
    <StackPanel Orientation="Horizontal" Margin="10,8" VerticalAlignment="Center">
      <Button Style="{StaticResource Small}" Width="34" Height="34" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" Click="Expand_Click" ToolTip="{l:T open_studio_tip}">
        <Path Data="M0,4 V0 H4 M8,0 H12 V4 M12,8 V12 H8 M4,12 H0 V8" Stroke="{DynamicResource Text}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" />
      </Button>
      <Button x:Name="PowerButton" Width="42" Height="42" Padding="0" Margin="0,0,10,0" Click="Power_Click" ToolTip="{l:T power_toggle}">
        <Grid Width="20" Height="24">
          <Path x:Name="Bulb" Stretch="Uniform" Fill="#6B7385"
                Data="M50,5 C27,5 10,22 10,44 C10,58 17,68 26,76 C31,81 33,86 33,92 L67,92 C67,86 69,81 74,76 C83,68 90,58 90,44 C90,22 73,5 50,5 Z M35,98 L65,98 L65,104 L35,104 Z M38,108 L62,108 C60,114 55,117 50,117 C45,117 40,114 38,108 Z" />
        </Grid>
      </Button>
      <Grid Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center">
        <Ellipse x:Name="Glow" Margin="-5" Opacity="0.9" />
        <Ellipse x:Name="Chip" Stroke="#59FFFFFF" StrokeThickness="1" />
      </Grid>
      <Slider x:Name="Bri" Width="150" Minimum="1" Maximum="100" Value="70" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="Bri_Changed" PreviewMouseLeftButtonUp="Bri_Release" KeyUp="Bri_KeyUp" ToolTip="{l:T brightness}" />
      <TextBlock x:Name="BriText" Text="%70" Width="40" Margin="8,0,6,0" FontWeight="SemiBold" Foreground="{DynamicResource AccentSoft}" VerticalAlignment="Center" TextAlignment="Right" />
      <Border Width="1" Background="{DynamicResource Stroke}" Margin="8,8" />
      <StackPanel x:Name="Favorites" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,0" />
      <Border Width="1" Background="{DynamicResource Stroke}" Margin="8,8" />
      <Border Style="{StaticResource Pill}" CornerRadius="15" Padding="2" Margin="0,0,8,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <ToggleButton x:Name="TabModes" Style="{StaticResource MiniSeg}" Content="{l:T modes}" Tag="Modlar" Click="Tab_Click" ToolTip="{l:T show_modes}" />
          <ToggleButton x:Name="TabScenes" Style="{StaticResource MiniSeg}" Content="{l:T scenes}" Tag="Sahneler" Click="Tab_Click" ToolTip="{l:T show_scenes}" />
        </StackPanel>
      </Border>
      <Button x:Name="ExitButton" Style="{StaticResource Small}" Margin="0" Width="34" Height="34" Padding="0" VerticalAlignment="Center" Click="Exit_Click" ToolTip="{l:T exit}">
        <Path Data="M4.2,3.4 A6,6 0 1 0 11.8,3.4 M8,1 V7.2" Stroke="{DynamicResource Text}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Opacity="0.85" />
      </Button>
    </StackPanel>
  </Grid>

    <!-- Açılır panel: sahneler veya modlar (aşağı ya da yukarı açılır) -->
    <Grid x:Name="PanelHost" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed" Width="{Binding ActualWidth, ElementName=Surface}" MouseLeftButtonDown="Drag">
      <Border CornerRadius="22" Background="{DynamicResource Backdrop}" Opacity="0.9">
        <Border.Effect>
          <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.35" Color="Black" RenderingBias="Performance" />
        </Border.Effect>
      </Border>
      <Border CornerRadius="22" Background="{DynamicResource Glass}" />
      <Border CornerRadius="22" Background="{DynamicResource GlassShine}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" IsHitTestVisible="False" />
      <StackPanel Margin="14,10,14,6">
        <TextBlock x:Name="PanelTitle" Text="{l:T scenes_upper}" Style="{StaticResource SectionLabel}" FontSize="10" Margin="2,0,0,6" />
        <WrapPanel x:Name="PanelItems" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
